#!/usr/bin/env bash
set -u

if [[ $# -lt 3 ]]; then
  printf 'usage: %s <semantic-action-id> <action-argument> <fallback> [args...]\n' "${0##*/}" >&2
  exit 64
fi

action_id="$1"
action_argument="$2"
shift 2

case "$action_id" in
  omarchy-browser | omarchy-menu | android-back | android-home | android-recent-apps)
    [[ -z "$action_argument" ]] || exit 64
    ;;
  android-launch-app)
    [[ "$action_argument" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$ ]] || exit 64
    ;;
  *)
    printf 'unsupported semantic action: %s\n' "$action_id" >&2
    exit 64
    ;;
esac

request_id="${BASHPID}-${RANDOM}-${RANDOM}"
runtime_root="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/omarchy-android"
result_path="$runtime_root/action-results/$request_id"
poll_attempts="${OMARCHY_ANDROID_ACTION_POLL_ATTEMPTS:-100}"
if [[ ! "$poll_attempts" =~ ^[1-9][0-9]*$ ]]; then
  poll_attempts=100
fi

now_unix_ms="$(date +%s%3N)"
expires_at_unix_ms=$((now_unix_ms + 2000))

response="$(/usr/bin/timeout --signal=KILL 3 omarchy-shell ollie.android action "$action_id" "$action_argument" "$request_id" "$expires_at_unix_ms" 2>/dev/null)"
if [[ "$response" == "true" ]]; then
  for ((attempt = 0; attempt < poll_attempts; ++attempt)); do
    if [[ -f "$result_path" ]]; then
      final_result=
      IFS= read -r final_result <"$result_path" || true
      rm -f "$result_path"
      if [[ "$final_result" == "true" ]]; then
        exit 0
      fi
      break
    fi
    sleep 0.05
  done
  exit 0
fi

exec "$@"
