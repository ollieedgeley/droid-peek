#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<EOF
usage: ${0##*/} [--dry-run] [--remove-helper] [--remove-v4l2] [--remove-user-config] [--remove-state] [--yes]

Remove Droid Peek host files after the plugin is disabled and idle.
Always removes the managed Hyprland loader block. Optional removals are
unchecked by default and never include shared packages or Avahi.

  --remove-helper        remove ~/.local/bin/droid-peek-helper
  --remove-v4l2          remove Droid Peek V4L2 config files only
  --remove-user-config   remove ~/.config/hypr/droid-peek.lua
  --remove-state         remove trusted-device and preferences state
  --yes                  non-interactive; loader only unless --remove-* is set
  --dry-run              print the plan and make no changes
EOF
  exit "${1:-0}"
}

_this_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib/common.sh
source "$_this_dir/lib/common.sh"
# shellcheck source=lib/v4l2.sh
source "$_this_dir/lib/v4l2.sh"
# shellcheck source=lib/hyprland.sh
source "$_this_dir/lib/hyprland.sh"

droid_peek_install_entry_traps

flag_helper=0
flag_v4l2=0
flag_user_config=0
flag_state=0
flags_set=0

while (($#)); do
  case "$1" in
    --dry-run)
      dry_run=1
      ;;
    --yes)
      yes=1
      ;;
    --remove-helper)
      flag_helper=1
      flags_set=1
      ;;
    --remove-v4l2)
      flag_v4l2=1
      flags_set=1
      ;;
    --remove-user-config)
      flag_user_config=1
      flags_set=1
      ;;
    --remove-state)
      flag_state=1
      flags_set=1
      ;;
    -h | --help)
      usage 0
      ;;
    *)
      usage 64
      ;;
  esac
  shift
done

ask_optional() {
  local prompt="$1"
  if gum confirm -- "$prompt"; then
    return 0
  fi
  return 1
}

require_idle() {
  if plugin_is_enabled; then
    fail "plugin $PLUGIN_ID is enabled. Disable it and close the panel before cleanup. No changes were made."
  fi
  if helper_is_running; then
    fail "a Droid Peek helper process is still running. Close the panel and stop those processes before cleanup. No changes were made."
  fi
  if scrcpy_is_helper_descendant; then
    fail "a scrcpy process started by the Droid Peek helper is still running. Close the panel before cleanup. No changes were made."
  fi
  require_video_idle
}

print_plan() {
  printf '%s\n' "Droid Peek cleanup plan"
  printf '%s\n' "======================="
  printf '\nAlways:\n'
  printf '  remove the managed loader block from %s\n' "$bindings_file"
  printf '  never remove shared packages or Avahi\n'
  printf '  never unload v4l2loopback or remove /dev/video%s\n' "$VIDEO_NR"
  printf '\nOptional (unchecked by default):\n'
  if ((flag_helper)); then
    printf '  remove helper %s\n' "$helper_path"
  else
    printf '  keep helper %s\n' "$helper_path"
  fi
  if ((flag_v4l2)); then
    printf '  remove %s\n' "$modules_load_file"
    printf '  remove %s\n' "$modprobe_file"
    printf '  the empty /dev/video%s device disappears only after reboot\n' "$VIDEO_NR"
  else
    printf '  keep V4L2 config files\n'
  fi
  if ((flag_user_config)); then
    printf '  remove user module %s\n' "$user_module"
  else
    printf '  keep user module %s\n' "$user_module"
  fi
  if ((flag_state)); then
    printf '  remove trusted-device and preferences state in %s\n' "$state_dir"
  else
    printf '  keep trusted-device and preferences state in %s\n' "$state_dir"
  fi
  printf '\n'
}

ask_optional_removals() {
  if ((flags_set)) || ((yes)) || ((dry_run)); then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    fail "standard input is not a terminal; re-run with --yes. No changes were made."
  fi
  if ! command -v gum >/dev/null 2>&1; then
    fail "install gum. No changes were made."
  fi
  printf '%s\n' "Cleanup always removes the managed Hyprland loader block."
  printf '%s\n' "Optional removals are unchecked. Shared packages and Avahi stay installed."
  if ask_optional "Remove installed helper $helper_path?"; then
    flag_helper=1
  fi
  if ask_optional "Remove Droid Peek V4L2 config files? The module and /dev/video$VIDEO_NR stay until reboot."; then
    flag_v4l2=1
  fi
  if ask_optional "Remove user Lua $user_module?"; then
    flag_user_config=1
  fi
  if ask_optional "Remove trusted-device and preferences state in $state_dir?"; then
    flag_state=1
  fi
}

perform_cleanup() {
  remove_managed_loader
  if ((flag_helper)); then
    rm -f -- "$helper_path"
  fi
  if ((flag_v4l2)); then
    remove_droid_peek_v4l2
  fi
  if ((flag_user_config)); then
    rm -f -- "$user_module"
  fi
  if ((flag_state)) && [[ -e "$state_dir" ]]; then
    rm -rf -- "$state_dir"
  fi
}

report_remaining() {
  printf '%s\n' "Cleanup finished."
  if has_loader; then
    fail "managed loader is still present in $bindings_file."
  fi
  printf '%s\n' "Managed loader removed."
  if [[ -e "$helper_path" ]]; then
    printf '%s\n' "Helper remains at $helper_path."
  fi
  if [[ -e "$modules_load_file" || -e "$modprobe_file" ]]; then
    printf '%s\n' "V4L2 configuration remains."
  fi
  if [[ -e "$user_module" ]]; then
    printf '%s\n' "User module remains at $user_module."
  fi
  if [[ -e "$state_dir" ]]; then
    printf '%s\n' "State remains in $state_dir."
  fi
}

droid_peek_set_stage parse
droid_peek_refresh_paths
require_cmd jq
require_cmd pgrep

droid_peek_set_stage preflight
require_idle
ask_optional_removals

droid_peek_set_stage plan
print_plan

if ((dry_run)); then
  printf '%s\n' "Dry-run: no changes were made."
  exit 0
fi

droid_peek_set_stage confirm
droid_peek_confirm "Proceed with this cleanup?"

droid_peek_set_stage apply
perform_cleanup

droid_peek_set_stage verify
report_remaining
