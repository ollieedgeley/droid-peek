-- ~/.config/hypr/droid-peek.lua
--
-- Droid Peek Android-mode bindings. Edit for your own Android device.

local android = dofile(
  os.getenv("HOME")
    .. "/.config/omarchy/plugins/ollieedgeley.droidpeek/integrations/phone-bindings.lua"
)

-- Session. Android still controls locking.
android.configure({
  scrcpyArgs = { "--keep-active", "--turn-screen-off", "--stay-awake", "--keyboard=uhid" },
})

android.define_submap("droid-peek", function()
  -- Panel
  android.bind("SUPER + ALT + A", "Close Android panel", android.close_panel)

  -- Navigation
  android.bind("ALT + TAB", "Recent apps", "android.recent-apps")
  android.bind("SUPER + W", "Home", "android.navigate.home")

  -- Clipboard (Android only; no desktop sync)
  android.bind("SUPER + C", "Copy", { type = "android.keyevent", key = "copy" })
  android.bind("SUPER + V", "Paste", { type = "android.keyevent", key = "paste" })
  android.bind("SUPER + X", "Cut", { type = "android.keyevent", key = "cut" })

  -- Volume
  android.bind("XF86AudioRaiseVolume", "Volume up", { type = "android.keyevent", key = "volume-up" })
  android.bind("XF86AudioLowerVolume", "Volume down", { type = "android.keyevent", key = "volume-down" })
  android.bind("XF86AudioMute", "Mute", { type = "android.keyevent", key = "volume-mute" })

  -- Media
  android.bind("XF86AudioNext", "Next track", { type = "android.keyevent", key = "media-next" })
  android.bind("ALT + XF86AudioPlay", "Next track", { type = "android.keyevent", key = "media-next" })
  android.bind("XF86AudioPause", "Play/pause", { type = "android.keyevent", key = "media-play-pause" })
  android.bind("XF86AudioPlay", "Play/pause", { type = "android.keyevent", key = "media-play-pause" })
  android.bind("XF86AudioPrev", "Previous track", { type = "android.keyevent", key = "media-previous" })
  android.bind("ALT + SHIFT + XF86AudioPlay", "Previous track", { type = "android.keyevent", key = "media-previous" })

  -- Search
  -- Uncomment at most one. Super+Space is shared.

  -- OnePlus Global Search
  -- android.bind("SUPER + SPACE", "OnePlus Global Search", {
  --   type = "android.component.launch",
  --   package = "com.oppo.quicksearchbox",
  --   activity = "com.oplus.globalsearch.ui.SearchActivity"
