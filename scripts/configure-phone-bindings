#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: %s install|uninstall\n' "${0##*/}" >&2
  exit 64
}

[[ $# -eq 1 ]] || usage

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd "$script_dir/.." && pwd)"
template="$root_dir/integrations/omarchy-android.lua.example"
config_home="${XDG_CONFIG_HOME:-${HOME:?HOME is required}/.config}"
hypr_dir="$config_home/hypr"
bindings_file="$hypr_dir/bindings.lua"
user_module="$hypr_dir/omarchy-android.lua"
loader_block='-- Omarchy Android plugin loader (managed)
require("hypr.omarchy-android")'
loader_comment="${loader_block%%$'\n'*}"
loader_require="${loader_block#*$'\n'}"

has_loader() {
  awk -v comment="$loader_comment" -v loader="$loader_require" '
    previous == comment && $0 == loader { found = 1 }
    { previous = $0 }
    END { exit found ? 0 : 1 }
  ' "$bindings_file"
}

install_bindings() {
  mkdir -p "$hypr_dir"
  if [[ ! -e "$user_module" ]]; then
    cp -- "$template" "$user_module"
  fi
  if [[ ! -e "$bindings_file" ]]; then
    : >"$bindings_file"
  fi
  if ! has_loader; then
    printf '\n%s\n' "$loader_block" >>"$bindings_file"
  fi
}

uninstall_bindings() {
  [[ -f "$bindings_file" ]] || return 0

  local destination="$bindings_file"
  if [[ -L "$bindings_file" ]]; then
    destination="$(readlink -f -- "$bindings_file")"
    [[ -f "$destination" ]] || {
      printf 'bindings.lua symlink target is not a regular file\n' >&2
      exit 1
    }
  fi

  local destination_dir temporary
  destination_dir="$(dirname "$destination")"
  temporary="$(mktemp "$destination_dir/.omarchy-android-bindings.XXXXXX")"
  trap 'rm -f "$temporary"' RETURN
  sed \
    -e '/^$/{N;/\n-- Omarchy Android plugin loader (managed)$/{N;/^\n-- Omarchy Android plugin loader (managed)\nrequire("hypr\.omarchy-android")$/d;}}' \
    -e '/^-- Omarchy Android plugin loader (managed)$/{N;/^-- Omarchy Android plugin loader (managed)\nrequire("hypr\.omarchy-android")$/d;}' \
    "$bindings_file" >"$temporary"
  chown --reference="$destination" "$temporary"
  chmod --reference="$destination" "$temporary"
  mv -- "$temporary" "$destination"
  trap - RETURN
}

case "$1" in
  install)
    install_bindings
    ;;
  uninstall)
    uninstall_bindings
    ;;
  *)
    usage
    ;;
esac
