#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<EOF
usage: ${0##*/} [--dry-run] [--yes]

Prepare this Omarchy host for Droid Peek after the plugin source is installed
and left disabled. Prints the full plan first. Interactive mode asks once
with gum before the first host mutation. --yes skips that prompt.
--dry-run prints the plan and makes no changes.

Setup never installs packages, enables a system service, or enables the
plugin. Avahi must already be active.

Environment:
  DROID_PEEK_HELPER_ASSET_DIR
    Local directory containing the versioned helper asset and SHA256SUMS.
    Used instead of downloading GitHub Release assets. Intended for tests
    and offline verification. The helper is never resolved from PATH.
EOF
  exit "${1:-0}"
}

_this_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib/common.sh
source "$_this_dir/lib/common.sh"
# shellcheck source=lib/release-helper.sh
source "$_this_dir/lib/release-helper.sh"
# shellcheck source=lib/v4l2.sh
source "$_this_dir/lib/v4l2.sh"
# shellcheck source=lib/hyprland.sh
source "$_this_dir/lib/hyprland.sh"

droid_peek_install_entry_traps

while (($#)); do
  case "$1" in
    --dry-run)
      dry_run=1
      ;;
    --yes)
      yes=1
      ;;
    -h | --help)
      usage 0
      ;;
    *)
      usage 64
      ;;
  esac
  shift
done

lua_action=""
loader_action=""

inspect_avahi() {
  require_cmd systemctl
  if systemctl is-active --quiet avahi-daemon.service; then
    return
  fi
  fail "avahi-daemon.service is not active. Start Avahi before running setup. Droid Peek does not enable system services. No changes were made."
}

print_plan() {
  printf '%s\n' "Droid Peek setup plan"
  printf '%s\n' "====================="

  printf '\nChecks:\n'
  printf '  architecture, stock linux kernel, matching headers, DKMS v4l2loopback, plugin disabled\n'

  printf '\nHelper:\n'
  printf '  version: %s\n' "$release_version"
  printf '  asset: %s\n' "$helper_source"
  printf '  SHA256SUMS: %s\n' "$sums_url"
  printf '  install path: %s (mode 0755)\n' "$helper_path"
  if [[ -n "$asset_dir" ]]; then
    printf '  source: local asset directory (DROID_PEEK_HELPER_ASSET_DIR)\n'
  else
    printf '  source: GitHub Release v%s\n' "$release_version"
  fi

  printf '\nAvahi:\n'
  printf '  avahi-daemon.service is already active (prerequisite)\n'

  printf '\nV4L2:\n'
  printf '  %s (v4l2loopback)\n' "$modules_load_file"
  printf '  %s (video_nr=%s card_label="%s" exclusive_caps=0)\n' \
    "$modprobe_file" "$VIDEO_NR" "$CARD_LABEL"
  if [[ "$v4l2_action" == "write-and-load" ]]; then
    printf '  load v4l2loopback once and verify /dev/video%s labelled %s\n' "$VIDEO_NR" "$CARD_LABEL"
  else
    printf '  module already loaded with inactive /dev/video%s labelled %s; write files only\n' \
      "$VIDEO_NR" "$CARD_LABEL"
  fi

  printf '\nUser configuration:\n'
  if [[ "$lua_action" == "preserve" ]]; then
    printf '  leave existing %s unchanged\n' "$user_module"
  else
    printf '  copy integrations/droid-peek.lua.example -> %s\n' "$user_module"
  fi
  if [[ "$loader_action" == "present" ]]; then
    printf '  managed loader already present in %s\n' "$bindings_file"
  else
    printf '  append managed require("hypr.droid-peek") loader to %s\n' "$bindings_file"
  fi
  printf '\n'
}

verify_setup() {
  local version_output name
  [[ -x "$helper_path" ]] || {
    printf '%s\n' "helper is not executable at $helper_path." >&2
    return 1
  }
  version_output="$("$helper_path" --version)" || {
    printf '%s\n' "helper --version failed at $helper_path." >&2
    return 1
  }
  [[ "$version_output" == "$release_version" ]] || {
    printf '%s\n' "helper --version reported '$version_output', expected '$release_version'." >&2
    return 1
  }

  [[ -e "$video_dev" ]] || {
    printf '%s\n' "dedicated V4L2 device $video_dev is missing." >&2
    return 1
  }
  name="$(video_name || true)"
  [[ "$name" == "$CARD_LABEL" ]] || {
    printf '%s\n' "dedicated V4L2 device is labelled '${name:-unknown}', expected '$CARD_LABEL'." >&2
    return 1
  }

  if ! systemctl is-active --quiet avahi-daemon.service; then
    printf '%s\n' "avahi-daemon.service is not active." >&2
    return 1
  fi

  plugin_is_discovered || {
    printf '%s\n' "plugin $PLUGIN_ID is not discovered. Run: omarchy-shell shell rescanPlugins" >&2
    return 1
  }
  if plugin_is_enabled; then
    printf '%s\n' "plugin $PLUGIN_ID became enabled before verification finished." >&2
    return 1
  fi

  [[ -e "$user_module" ]] || {
    printf '%s\n' "user module $user_module is missing." >&2
    return 1
  }
  has_loader || {
    printf '%s\n' "managed loader is missing from $bindings_file." >&2
    return 1
  }
}

print_enable_command() {
  printf '%s\n' "Setup completed. Enable Droid Peek only after reviewing the host changes."
  printf '%s\n' "  omarchy plugin enable $PLUGIN_ID"
}

droid_peek_set_stage parse
droid_peek_refresh_paths
asset_dir="${DROID_PEEK_HELPER_ASSET_DIR:-}"
require_cmd uname
require_cmd jq
require_cmd sha256sum
require_cmd awk

droid_peek_set_stage preflight
run_check_release_version
check_architecture
check_kernel
refuse_if_plugin_enabled
check_kernel_headers
check_dkms_v4l2loopback
inspect_helper
inspect_avahi
inspect_v4l2
if [[ -e "$user_module" ]]; then
  lua_action="preserve"
else
  lua_action="copy"
fi
if has_loader; then
  loader_action="present"
else
  loader_action="append"
fi

droid_peek_set_stage plan
print_plan

if ((dry_run)); then
  printf '%s\n' "Dry-run: no changes were made."
  exit 0
fi

droid_peek_set_stage confirm
droid_peek_confirm "Proceed with these host changes?"

droid_peek_set_stage helper
install_helper
droid_peek_created_helper=1
droid_peek_inject_after after-helper

droid_peek_set_stage v4l2
provision_v4l2
droid_peek_created_v4l2=1
droid_peek_inject_after after-v4l2

droid_peek_set_stage loader
install_user_config
droid_peek_created_loader=1
droid_peek_inject_after after-loader

droid_peek_set_stage verify
if ! verify_setup; then
  fail "Setup verification failed."
fi
print_enable_command
